# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/weathrly

# Free key from https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweathermap_api_key

# Secret used to sign JWTs. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace_with_a_long_random_string

# Comma-separated list of origins allowed by CORS
ALLOWED_ORIGINS=http://localhost:5173

# Base URL of the frontend, used to build password reset links
FRONTEND_URL=http://localhost:5173

# Optional: SMTP server for password reset emails. Leave SMTP_HOST empty in development
# and the reset link is printed in the server log instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
